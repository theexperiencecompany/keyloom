{
  "name": "keyloom",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "@remotion/web-renderer@4.0.459": "patches/@remotion%2Fweb-renderer@4.0.459.patch"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
