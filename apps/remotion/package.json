{
  "name": "@workspace/compositions",
  "version": "1.0.0",
  "description": "Keyloom composition library",
  "license": "MIT",
  "private": true,
  "exports": {
    "./editors": "./src/editors/index.ts",
    "./*": [
      "./src/*.tsx",
      "./src/*.ts"
    ]
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@remotion/cli": "4.0.459",
    "@remotion/fonts": "4.0.459",
    "@remotion/google-fonts": "4.0.459",
    "@remotion/lambda": "4.0.459",
    "@remotion/layout-utils": "4.0.459",
    "@remotion/media": "4.0.459",
    "@remotion/tailwind-v4": "4.0.459",
    "@remotion/transitions": "4.0.459",
    "@tanstack/react-query": "^5.100.9",
    "@workspace/ui": "workspace:*",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "4.0.459",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.10",
    "@types/web": "0.0.166",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "remotionb studio",
    "build": "remotionb bundle",
    "deploy:site": "remotion lambda sites create src/index.ts --site-name=motion-studio",
    "deploy:function": "remotion lambda functions deploy",
    "upgrade": "remotionb upgrade",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "sideEffects": [
    "*.css"
  ]
}
