# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem
.local/

# Local screenshots / scratch files
.tmp/

# Locally-uploaded audio (e.g. copyrighted tracks) used for renders.
# apps/remotion/public is a symlink to apps/web/public — single rule covers
# both apps.
apps/web/public/audio/uploads/

# Git worktrees checked out inside the repo
worktrees/

# Generated from the composition registry by apps/web/scripts/generate-sources.mjs.
# Regenerated by the predev / prebuild / pretypecheck / prelint hooks, so it never
# needs to be committed — 71 revisions of it were pure history weight.
apps/web/lib/generated-sources.ts
apps/web/lib/preview-loaders.ts

# Other package managers' lockfiles (this repo uses bun.lock)
pnpm-lock.yaml
package-lock.json
yarn.lock

# Claude Code local state
.claude/*.lock
.claude/settings.local.json

# Generated by next dev / next build
apps/web/next-env.d.ts
