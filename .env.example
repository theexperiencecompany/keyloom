# Copy to apps/web/.env.local and fill in what you need. Everything is optional
# unless the feature that reads it is used.

# Public origin of the web app (used for share/download links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Fallback origin for short download links (defaults to the Vercel URL).
APP_BASE_URL=

# Forks ("My projects"). Neon Postgres connection string. Only loaded when a
# fork is created or read.
DATABASE_URL=

# Whisper transcription for /captions.
OPENAI_API_KEY=

# Google Fonts picker in the Inspector.
GOOGLE_FONTS_API_KEY=

# Cloudflare R2 bucket holding music, meme templates and gameplay clips.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_MUSIC_PREFIX=music/
R2_MEME_PREFIX=memes/
R2_GAMEPLAY_PREFIX=gameplay/
# Public CDN in front of the meme templates (direct R2 URL if unset).
NEXT_PUBLIC_MEME_CDN=
NEXT_PUBLIC_MEME_DIRECT=

# Remotion Lambda ("exact" cloud export). See apps/remotion deploy:* scripts.
REMOTION_AWS_REGION=ap-south-1
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_MAX_RETRIES=
REMOTION_LAMBDA_FRAMES_PER_LAMBDA=
REMOTION_LAMBDA_CONCURRENCY_PER_LAMBDA=
# Base URL the Lambda renderer fetches relative image paths from.
EXTERNAL_ASSET_BASE_URL=
